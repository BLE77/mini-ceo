# Optional: connect the Mini CEO assistant adapter to a hosted Hermes-compatible endpoint.
# The endpoint should accept JSON with { agent, message, context, history, system }
# and return { reply }, { message }, or { content }.
HERMES_API_URL=
HERMES_API_KEY=

# Hosted character voice. Keep the real value in the host's encrypted environment.
ELEVENLABS_API_KEY=
# Optional partial or exact voice name from the connected ElevenLabs library.
ELEVENLABS_VOICE_NAME=Adam

# Hosted boss brain. The model can be changed without a client release.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=cognitivecomputations/dolphin-mistral-24b-venice-edition:free
# Grok 4+ provides native current-web and X search through OpenRouter.
OPENROUTER_RESEARCH_MODEL=x-ai/grok-4.3

# Standards-based Web Push. Generate these as a matched VAPID pair.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://mini-ceo-creator.ble77.chatgpt.site
PUSH_DISPATCH_SECRET=
